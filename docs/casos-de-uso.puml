@startuml
left to right direction
actor Cliente
actor "Agente (Empresa)" as Empresa
actor "Agente (Banco)" as Banco
Banco -|> Empresa
rectangle "Sistema de Aluguel de Carros" {
  usecase "Cadastrar-se / Fazer login" as UC1
  usecase "Gerenciar dados do cliente (CRUD)" as UC2
  usecase "Criar pedido de aluguel" as UC3
  usecase "Consultar pedidos e status" as UC4
  usecase "Modificar pedido" as UC5
  usecase "Cancelar pedido" as UC6
  usecase "Avaliar pedido (análise financeira)" as UC7
  usecase "Executar contrato de aluguel" as UC8
  usecase "Conceder contrato de crédito" as UC9
}
Cliente --> UC1
Cliente --> UC2
Cliente --> UC3
Cliente --> UC4
Cliente --> UC5
Cliente --> UC6
Empresa --> UC1
Empresa --> UC2
Empresa --> UC4
Empresa --> UC5
Empresa --> UC7
Empresa --> UC8
Banco --> UC9
UC9 .> UC8 : <<extend>>
@enduml
